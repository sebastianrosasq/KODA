{
  "expo": {
    "name": "KODA",
    "slug": "koda",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/koda-icon.png",
    "scheme": "koda",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/koda-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0C0F",
        "foregroundImage": "./assets/images/koda-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/koda-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C0F",
          "image": "./assets/images/koda-mark.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D4AFF",
          "defaultChannel": "study-reminders"
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      "expo-secure-store",
      "expo-document-picker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
